<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app is signed with the hardened runtime, so other processes can't inject code into it with
	     DYLD_* variables or a debugger, and use its Full Disk Access. Library validation, though, only
	     loads frameworks with the app's Team ID, and a self-signed certificate or an ad-hoc signature has
	     none, so it refuses Sparkle.framework, the updater, even signed the same way. This turns off only
	     that check. The cost: a copy of the app with other code in its Sparkle.framework would load it
	     with BriefBar's Full Disk Access (see "How the app is signed" in SECURITY.md).
	     scripts/check-app.sh fails on any other entitlement. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
