<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:BriefBar.Views">

    <!-- The brief's card: a soft gradient with a lilac edge in light and dark, and Windows' own colors in High
         Contrast. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <LinearGradientBrush x:Key="BriefBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#33F7C6DE" />
                <GradientStop Offset="0.5" Color="#26D9CCFA" />
                <GradientStop Offset="1" Color="#33C6DCFA" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="BriefBorderBrush" Color="#BFB9A3F3" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <LinearGradientBrush x:Key="BriefBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#26F0A3CB" />
                <GradientStop Offset="0.5" Color="#1AB9A3F3" />
                <GradientStop Offset="1" Color="#2695BFF5" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="BriefBorderBrush" Color="#73B9A3F3" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="BriefBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BriefBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- An item in the bar. It's as tall as the bar, so a flick of the pointer to the screen's edge lands on it; its
         highlight is inset and rounded, as the taskbar's is; and an accent mark shows under it while its panel is open,
         as the taskbar marks the app in front. Hover and the open state each have their own highlight, so neither
         undoes the other. -->
    <Style x:Key="BarItemButtonStyle" TargetType="views:BarItemButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,0,10,0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="1,3,1,3" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="views:BarItemButton">
                    <Grid x:Name="RootGrid" Background="Transparent">
                        <Border x:Name="OpenHighlight" Margin="1,3,1,3" CornerRadius="4" Background="Transparent" />
                        <Border x:Name="Highlight" Margin="1,3,1,3" CornerRadius="4" Background="Transparent" />
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}" />
                        <Rectangle
                            x:Name="OpenMark"
                            Width="16"
                            Height="3"
                            Margin="0,0,0,2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                            Opacity="0"
                            RadiusX="1.5"
                            RadiusY="1.5" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Highlight.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Highlight.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="OpenStates">
                                <VisualState x:Name="Closed" />
                                <VisualState x:Name="Open">
                                    <VisualState.Setters>
                                        <Setter Target="OpenHighlight.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        <Setter Target="OpenMark.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A button that's only an icon, such as the panel's More: no fill until you point at it. -->
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="8,6,8,6" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <!-- A command in the panel's footer, such as "Open GitHub Copilot": an icon and words, with no fill until you point
         at it. -->
    <Style x:Key="FooterButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
        <Setter Property="Padding" Value="8,6,10,6" />
    </Style>

    <!-- Words that act, with no fill until you point at them: a group's Clear, the heading of a group that folds. -->
    <Style x:Key="SubtleTextButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <!-- A row's ↳ tag, which names what it belongs with: small and rounded, and a button when it opens that. -->
    <Style x:Key="RowTagButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Padding" Value="7,1,8,2" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MaxWidth" Value="260" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="RowTagBorderStyle" TargetType="Border">
        <Setter Property="Padding" Value="7,1,8,2" />
        <Setter Property="MaxWidth" Value="260" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
    </Style>

    <!-- A setting, as Windows 11's Settings lays one out: a card, with what it is on the left and its control on the
         right. -->
    <Style x:Key="SettingsCardStyle" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="16,12,16,12" />
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="ColumnSpacing" Value="16" />
    </Style>

    <!-- A card that opens a page, such as a source's from General. -->
    <Style x:Key="SettingsCardButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="16,12,16,12" />
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    </Style>

    <Style x:Key="SettingsCardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingsCardDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A heading over a group of cards, as Windows 11's Settings has, which Narrator's H key reaches. -->
    <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="1,28,0,6" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>
</ResourceDictionary>
