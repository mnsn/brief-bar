# Swift Package Manager and Xcode
.build/
.swiftpm/
DerivedData/
*.xcodeproj
xcuserdata/
*.dSYM

# Build output: the app bundle, demo data and screenshots
build/
# Default `--render` output. Renders of your own data show private names, messages and titles.
render/

# Signing keys never belong in the repository (see "Signing" and "The release keys" in CONTRIBUTING.md).
*.p12
*.pfx
*.pem
*.key
*.keychain
*.keychain-db
private-key*

# Editors and macOS
.vscode/
.idea/
.DS_Store

# The Windows app's build output, and Visual Studio's state
windows/**/bin/
windows/**/obj/
windows/.vs/
windows/**/*.user
